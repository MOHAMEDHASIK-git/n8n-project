    {
      "parameters": {
        "jsCode": "const chatId = $json.chatId;\n\n// If no rows from sheet\nif (items.length === 0) {\n  return [{\n    chatId,\n    stage: \"new\"\n  }];\n}\n\n// Convert all rows\nconst rows = items.map(i => i.json);\n\n// Find matching user\nconst user = rows.find(r => String(r.chatId) === String(chatId));\n\nif (!user) {\n  return [{\n    chatId,\n    stage: \"new\"\n  }];\n}\n\nreturn [{\n  chatId,\n  stage: user.stage || \"new\",\n  slotNumber: user.slotNumber || \"\"\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
