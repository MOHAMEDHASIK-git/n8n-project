    {
      "parameters": {
        "jsCode": "// Get chatId directly from Telegram Trigger\nconst triggerChatId = $items(\"Telegram Trigger\")[0].json.message.chat.id;\n\n// Filter available slots\nconst slots = items.filter(function(i) {\n  return i.json.Status && i.json.Status.toLowerCase() === \"available\";\n});\n\nlet text = \"\";\n\nif (!slots || slots.length === 0) {\n  text = \"All slots are booked ❌\";\n} else {\n  text = \"Available slots:\\n\";\n\n  for (let i = 0; i < slots.length; i++) {\n    const slotNumber = slots[i].json.ID;\n    const slotTime = slots[i].json.Time;\n\n    text += (i + 1) + \". \" + slotNumber + \" (\" + slotTime + \")\\n\";\n  }\n\n  text += \"\\nReply with slot number.\";\n}\n\n// Return\nreturn [\n  {\n    json: {\n      chatId: triggerChatId,\n      text: text\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -448,
        160
      ],
      "id": "c5394ac4-e280-42a2-a505-fcd65eb893d9",
      "name": "Code in JavaScript2"
    },
    {
      "parameters": {
        "jsCode": "// Get user input number\nconst num = parseInt($json.text);\n\n// Invalid input\nif (isNaN(num)) {\n  return [\n    {\n      json: {\n        chatId: $json.chatId,\n        text: \"Invalid input ❌\"\n      }\n    }\n  ];\n}\n\n// Find matching row (ID match)\nconst match = items.find(item => String(item.json.ID).trim() === String(num));\n\n// If no match\nif (!match) {\n  return [\n    {\n      json: {\n        chatId: $json.chatId,\n        text: \"Invalid slot ❌\"\n      }\n    }\n  ];\n}\n\n// ✅ Return ID + Time\nreturn [\n  {\n    json: {\n      chatId: $json.chatId,\n      ID: match.json.ID,\n      Time: match.json.Time\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
