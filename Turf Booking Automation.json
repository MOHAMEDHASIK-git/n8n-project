    {
      "parameters": {
        "jsCode": "// Get chatId from Telegram Trigger\nconst chatId = $items(\"Telegram Trigger\")[0].json.message.chat.id;\n\n// All rows from sheet\nconst rows = items;\n\n// 🔥 Check if ALL slots are booked\nconst allBooked = rows.every(function(item) {\n  return item.json.Status && item.json.Status.toLowerCase() === \"booked\";\n});\n\n// ❌ If all slots booked → message + chatId\nif (allBooked) {\n  return [\n    {\n      json: {\n        chatId: chatId,   // ✅ FIX\n        text: \"All slots are booked ❌\"\n      }\n    }\n  ];\n}\n\n// Check existing user\nconst existingUser = rows.find(function(item) {\n  return item.json.chatId == chatId;\n});\n\n// ❌ Already exists → message + chatId\nif (existingUser) {\n  return [\n    {\n      json: {\n        chatId: chatId,   // ✅ FIX\n        text: \"Already booked ❌\"\n      }\n    }\n  ];\n}\n\n// ✅ New user → full data\nreturn [\n  {\n    json: {\n      chatId: chatId,\n      stage: \"start\",\n      slotNumber: \"\",\n      selectedTime: \"\",\n      text: \"Welcome to Turf Booking ⚽...\\n\\nType \\\"book\\\" to start\"\n    }\n  }\n];"
      },
