    {
      "parameters": {
        "jsCode": "// Get chatId from Telegram Trigger\nconst chatId = $items(\"Telegram Trigger\")[0].json.message.chat.id;\n\n// Current stage (from previous node / sheet)\nconst currentStage = $json.stage;\n\n// Get slot data\nconst slot = items[0]?.json;\n\n// ❗ If no slot OR already booked\nif (!slot || !slot.Status || slot.Status.toLowerCase() !== \"available\") {\n\n  // If already in start → move to select_slot\n  const nextStage = currentStage === \"start\" ? \"select_slot\" : \"start\";\n\n  return [\n    {\n      json: {\n        chatId: chatId,\n        stage: nextStage,   // ✅ toggle logic\n        slotNumber: slot?.ID || \"\",\n        selectedTime: slot?.Time || \"\"\n      }\n    }\n  ];\n}\n\n// ✅ Success\nreturn [\n  {\n    json: {\n      chatId: chatId,\n      stage: \"enter_details\",\n      slotNumber: slot.ID,\n      selectedTime: slot.Time\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
